;;; Commentary:
;; Provides the core VANISH-LISP primitive macros:
;; vanish, reduce, normalize, under, derivative, vanish-ideal,
;; residue, witness, and seal.

;;; Code:

(require 'vanish)
(require 'reader)

(defmacro vanish (expr)
  "Normalize EXPR and check whether it vanishes to 0."
  `(vl-eval-form ',expr))

(defmacro reduce (expr)
  "Perform symbolic reduction on EXPR."
  `(vl-eval-form ',expr))

(defmacro normalize (expr)
  "Return canonical normal form of EXPR."
  `(vl-normalize ',expr))

(defmacro under (constraints expr)
  "Evaluate EXPR under mathematical CONSTRAINTS."
  `(vl-normalize (vl-apply-constraints ',constraints (vl-eval-form ',expr))))

(defmacro derivative (var expr)
  "Symbolically differentiate EXPR with respect to VAR."
  `(vl-derivative ',var ',expr))

(defmacro vanish-ideal (generators expr)
  "Query whether EXPR belongs to the polynomial ideal generated by GENERATORS."
  `(list :ideal ',(cdr generators) :target ',expr
         :pop11 ,(vl-sexp-to-pop11 (list 'vanish-ideal generators expr))))

(defmacro residue (generators expr)
  "Compute the remaining algebraic terms of EXPR modulo GENERATORS."
  `(list :residue-of ',expr :modulo ',(cdr generators)))

(defmacro witness (constraints expr)
  "Request a counterexample witness where EXPR != 0 under CONSTRAINTS."
  `(list :witness :constraints ',constraints :expr ',expr
         :verdict (vl-vanish-p (vl-apply-constraints ',constraints ',expr))))

(defmacro seal (expr)
  "Require a Lean-validated proof that EXPR vanishes."
  `(list :seal :expr ',expr
         :lean-obligation ,(vl-emit-lean-theorem "sealed_obligation" expr)))

(provide 'macros)
;;; macros.el ends here
